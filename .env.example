# Single source of configuration for the project.
# Copy to `.env` (gitignored) and adjust:  cp .env.example .env
#
# - Docker Compose reads this file for ${VAR} interpolation.
# - The backend (run from backend/) reads it via env_file=("../.env", ".env").
# - The frontend loads NEXT_PUBLIC_* from it in next.config.ts, so host dev
#   (`npm run dev` from frontend/) works without a separate frontend/.env.local.

# --- Runtime ---
# Set to `production` in deployment. When it is not a development value,
# JWT_SECRET must be changed from the default and be at least 32 characters,
# otherwise the backend refuses to start.
ENVIRONMENT=development
SQL_ECHO=false
TZ=Europe/Rome

# --- Database ---
# DATABASE_URL is used for host dev (uvicorn run from backend/).
# Docker Compose builds the in-container URL from DB_* and points to the `db` host.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/jac_rag
DB_USER=user
DB_PASSWORD=password
DB_NAME=jac_rag
DB_PORT=5432

# --- Infrastructure ports ---
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
REDIS_PORT=6379
OLLAMA_PORT=11434
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Services (host dev values; Compose uses in-network service names) ---
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0
# QDRANT_API_KEY=            # only for a managed Qdrant; leave unset for local

# --- Auth / secrets ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
INVITATION_EXPIRE_DAYS=7

# --- HTTP ---
CORS_ORIGINS=http://localhost:3000
# Auth cookies. Secure=false only for local http dev; set true behind https.
# SameSite: "lax" for same-origin dev; "none" (requires secure) for cross-site.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# --- Storage ---
STORAGE_DIR=./storage
FASTEMBED_CACHE_PATH=./fastembed_cache
MAX_UPLOAD_MB=20

# --- Embeddings & retrieval ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
MIN_CHARS_PER_PAGE=30
RELEVANCE_THRESHOLD=0.35
RETRIEVAL_TOP_K=10
HYBRID_ENABLED=true
RRF_K=10

# Cross-encoder reranker (local, in-process via fastembed; no Ollama).
# Candidates over-fetched then reranked; CHAT_CONTEXT_K chunks reach the LLM.
# RERANK_MODE memory strategy:
#   on_demand -> load for the rerank, unload before the LLM (low RAM, +1-2s/chat)
#   warmup    -> preload at startup and keep resident (fast, ~1.2GB always held)
# RERANK_BATCH_SIZE caps the cross-encoder batch: lower = much less peak RAM,
# similar speed (fastembed's default 64 spikes several GB on long candidates).
RERANK_ENABLED=true
RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual
RERANK_CANDIDATES=30
RERANK_BATCH_SIZE=4
RERANK_MODE=on_demand
CHAT_CONTEXT_K=5

# --- Chunking (structure-aware) ---
# CHUNK_SIZE is the soft target; CHUNK_MAX_SIZE is the hard ceiling. Semantic
# units (table rows, list items) are never split below the ceiling.
CHUNK_SIZE=1000
CHUNK_MAX_SIZE=1600
CHUNK_OVERLAP=150
CHUNK_TABLE_CONTEXT=true
CHUNK_SECTION_CONTEXT=true
CHUNK_INCLUDE_METADATA=true

# --- Parsing ---
# Keep repeated header/footer blocks marked but present by default.
DROP_REPEATED_LAYOUT=false
PARSER_DEBUG=false

# --- OCR (feature flag; text layer always wins over OCR) ---
# OCR is used only when the text layer is missing, or to recover labels that
# live inside a page image. Language follows the tenant locale (it/en).
OCR_ENABLED=true
OCR_DPI=300
OCR_MIN_CONFIDENCE=0.5
OCR_IMAGE_DOMINANCE_RATIO=0.6

# --- LLM ---
# Ollama is always available. External providers (OpenAI-compatible: OpenAI,
# OpenRouter, OpenCode, vLLM...) are opt-in per tenant: when enabled, the tenant
# stores base_url + model + api_key (encrypted at rest) from the CMS.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
LLM_DEFAULT_PROVIDER=ollama
EXTERNAL_API_ENABLED=false
# Fernet key used to encrypt tenant secrets; change it in production.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-key

# --- Frontend ---
# The browser talks to the Next.js server on the same origin (/api/*), which
# proxies to the backend. API_PROXY_TARGET is server-side (not exposed publicly).
# Host dev: http://localhost:8000 ; Docker Compose overrides it to http://backend:8000
API_PROXY_TARGET=http://localhost:8000
